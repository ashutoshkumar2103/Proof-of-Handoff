# Address of the HandOffly backend that the support portal talks to.
#  - Development: the dev server proxies /api here (default http://localhost:8080 if unset).
#  - Production build: set this to the public backend URL before running `npm run build`
#    (leave empty only if the portal is served from the same host as the API).
VITE_API_BASE_URL=http://localhost:8080

# Optional. Where the HandOffly API is, when the app is served from a different origin than the API (production).
# Leave unset when the web server in front of the app passes /api on to the backend (same origin): requests then go to "/api/v1/...".
# A different origin needs that origin listed in the backend's CORS_ALLOWED_ORIGINS (see README.md).
# VITE_API_BASE_URL=https://api.example.com

# Development only: where the dev server passes /api on to (default http://localhost:8080).
# VITE_DEV_API_TARGET=http://localhost:8080

# Extra hostnames the dev/preview server accepts (the ngrok domains are already allowed). Comma separated.
# VITE_ALLOWED_HOSTS=m.example.com

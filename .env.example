# Copy to .env and adjust. NEVER commit real secrets.

# --- Database (MySQL 8.4) ---
MYSQL_DATABASE=handoffly
MYSQL_USER=handoffly
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# Consumed by the backend (docker-compose wires these to the app):
DB_URL=jdbc:mysql://mysql:3306/handoffly?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=handoffly
DB_PASSWORD=change-me-db-password

# --- Security ---
# Must be at least 32 bytes. Generate e.g.:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MINUTES=720

# --- Recipient links ---
# Public base URL of the frontend recipient review route (token is appended).
RECIPIENT_LINK_BASE_URL=http://localhost:5173/r
RECIPIENT_TOKEN_TTL_DAYS=30

# --- Email ---
# Running the backend from VS Code / Maven (not Docker)? Put just these mail lines in a file called
# .env.local in the repo root (git-ignored; the backend reads it on startup, no quotes needed).
# logging = dev (logs the link, sends nothing). smtp = real delivery.
MAIL_PROVIDER=logging
MAIL_FROM=no-reply@handoffly.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# --- Storage ---
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=/app/storage-data
STORAGE_MAX_FILE_SIZE_BYTES=15728640

# --- Support ---
# New-ticket notices are emailed here; it is also the general contact address on the public site.
SUPPORT_MAILBOX=support@handoffly.local
# Direct-call number, shown ONLY to customers whose plan includes phone support. Blank = no call option.
SUPPORT_PHONE=
# DEMO payment page: anyone can "pay" for a plan with no real money, to test the sign-up flow. Development/testing only —
# keep false in production (until a real payment provider replaces it).
PAYMENT_DEMO_ENABLED=false
# Bootstraps a support STAFF account (the first ADMIN) on startup if none with that email exists (never overwrites a
# password). The admin then creates everyone else in the support portal.
# Staff are a separate identity from customers. Use a strong password (12+ characters) and remove
# SUPPORT_STAFF_PASSWORD after the first start. Blank = nothing is created. Role: ADMIN, MANAGER or TICKET_AGENT.
SUPPORT_STAFF_NAME=
SUPPORT_STAFF_EMAIL=
SUPPORT_STAFF_PASSWORD=
SUPPORT_STAFF_ROLE=ADMIN
STAFF_JWT_EXPIRATION_MINUTES=480

# --- CORS ---
# Browser origins allowed to call the API: the customer app, and the support portal (port 5175 in dev).
# In production list the real origins only.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175

# --- Password reset ---
# The customer-app page that completes a reset; the one-time token is appended to it. Use the real site in production.
PASSWORD_RESET_LINK_BASE_URL=http://localhost:5173/reset-password
PASSWORD_RESET_TTL_MINUTES=30

# --- Abuse limits ---
# In-memory, per backend instance (see README). The individual limits (RATE_LIMIT_LOGIN_PER_IP and friends) are in
# application.yml. Behind a reverse proxy set FORWARD_HEADERS_STRATEGY=native so limits count real client addresses.
RATE_LIMIT_ENABLED=true
FORWARD_HEADERS_STRATEGY=none

# --- Scheduled jobs ---
# Customer reminders / weekly summary and the support team's subscription-expiry reminder. Set JOBS_SCHEDULER_ENABLED=false
# on instances that should not run them (every job starts switched off until a customer or staff member turns it on).
JOBS_SCHEDULER_ENABLED=true
JOBS_DEFAULT_TIMEZONE=Asia/Kolkata
# How many days before a subscription ends the expiry job reminds the customer (staff can change it in the portal).
JOBS_EXPIRY_WINDOW_DAYS=7
